QDRANT_COLLECTION=regulations
QDRANT_AUDIT_COLLECTION=media_audit

# Public URL — evidenceUrl in VCs points here (use IP:8000 until HTTPS is live)
PUBLIC_BASE_URL=http://54.154.92.29:8000

DEFAULT_LLM_PROVIDER=mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional API keys for write endpoints (comma-separated). Leave empty for open demo mode.
API_KEYS=

# Scoring — defaults match calibrated Jun 2026 weights; paper profile: {"m":0.30,"a":0.30,"v":0.20,"p":0.20}
# SIGNAL_WEIGHTS={"m":0.18,"a":0.22,"v":0.15,"p":0.45}
PLATT_ENABLED=false
WARMUP_ON_START=true

# Set by deploy/deploy.sh or CI
GIT_COMMIT=

