# Copy to src/.env — never commit src/.env

MISTRAL_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Public URL for evidenceUrl in issued VCs (EC2: http://<ip>:8000). Leave empty for local dev.
PUBLIC_BASE_URL=

# LLM synthesis: mistral (cloud API) or ollama (local). Used by /api/issue; Query UI overrides per request.
DEFAULT_LLM_PROVIDER=mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_REQUEST_TIMEOUT=120

SYBOL_API_BASE_URL=https://api.develop.wallet.sybol.id

# Cognito develop (Pelayo — client id 39ergo6f0l4gk195ld6sjoi41p)
SYBOL_COGNITO_CLIENT_ID=39ergo6f0l4gk195ld6sjoi41p
SYBOL_COGNITO_REGION=eu-west-1

# Paste tokens after login, or use email/password below
SYBOL_ACCESS_TOKEN=
SYBOL_ID_TOKEN=

SYBOL_EMAIL=
SYBOL_PASSWORD=

# Catalog doc — run sybol_discover_catalog (public, no login)
# Media Compliance catalog on develop (override for other tenants)
SYBOL_DOCUMENT_ID=0acdb1ed-4cd2-41a4-917a-b7270d6166b9
# Default develop issuer DID from Pelayo (override if settings API returns another)
SYBOL_ISSUER_KEY=did:web:did.develop.sybol.id:tenants:sybol#ebcbb38c-1cfb-41a9-80a2-17bcaa3a5564
SYBOL_RECIPIENT_DID=did:web:did.develop.sybol.id:tenants:sybol
SYBOL_CREDENTIAL_FORMAT=jwt_vc_json
SYBOL_SUBJECT_DID=
SYBOL_LEVEL_OF_ASSURANCE=2
SYBOL_REQUEST_TIMEOUT=30.0
