# Copy to src/.env — never commit src/.env

MISTRAL_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM synthesis: mistral (cloud API) or ollama (local). Used by /api/issue; Query UI overrides per request.
DEFAULT_LLM_PROVIDER=mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_REQUEST_TIMEOUT=120

SYBOL_API_BASE_URL=https://api.develop.wallet.sybol.id

# Cognito app client for Issue-tab sign-in (InitiateAuth USER_PASSWORD_AUTH)
SYBOL_COGNITO_CLIENT_ID=
SYBOL_COGNITO_REGION=eu-west-1

# Paste from wallet DevTools after browser login (optional fallback)
SYBOL_ACCESS_TOKEN=
SYBOL_ID_TOKEN=

# Optional — sign in on the Issue tab instead of pasting tokens above.
SESSION_SECRET_KEY=dev-only-change-in-production

# Or login via API if provisioned (currently 401 on develop)
SYBOL_EMAIL=
SYBOL_PASSWORD=

# From sybol_discover_catalog or Iñigo (MediaCompliance doc does not exist yet)
SYBOL_DOCUMENT_ID=
SYBOL_ISSUER_KEY=
SYBOL_RECIPIENT_DID=
SYBOL_CREDENTIAL_FORMAT=jwt_vc_json
SYBOL_SUBJECT_DID=
SYBOL_LEVEL_OF_ASSURANCE=2
SYBOL_REQUEST_TIMEOUT=30.0
