openapi: 3.0.3
info:
  title: BusinessWallet — Corporate Wallet API
  version: "4"
  description: |
    Machine-readable OpenAPI surface for the **Corporate Wallet** (BusinessWallet)
    product — the operator console for an organization acting simultaneously as a
    credential **Issuer**, **Holder** and **Verifier** of W3C / IETF SD-JWT
    verifiable credentials.

    This spec documents every backend REST endpoint the product consumes, grouped
    by family. For the narrative reference, status tables, integration flows and
    cURL examples see `apidefinition.md` in this directory.

    **Tenancy.** Every request is tenant-isolated. Authentication issues two tokens:
    an `accessToken` (`Authorization: Bearer`) and an `idToken` (`X-Id-Token`) that
    carries the `custom:tenant_id` claim used for tenant-scoped database access.

    **Response envelope (API v4).** Successful payloads are wrapped in a `data`
    envelope; list endpoints add a `pagination` object. Errors follow the
    platform-wide standard (see `../../global/api/error-handling.md`).
  contact:
    name: Sybol

servers:
  - url: https://api.develop.wallet.sybol.id
    description: Development (default)

tags:
  - name: Authentication
    description: Sign-in, token refresh and session (REST wrapper over AWS Cognito)
  - name: Credentials
    description: Issue, fetch, update, revoke and list verifiable credentials
  - name: Presentations
    description: Presentation request / response (proof) exchange
  - name: Catalog
    description: Documents, claims, forms, sections, fields and VCT metadata
  - name: Contacts
    description: Corporate and individual contact network
  - name: OID4VC
    description: Mobile-wallet issuance offers (OID4VCI) and verification sessions (OID4VP)
  - name: Entity & Settings
    description: Tenant entities and tenant settings
  - name: Activity & Dashboard
    description: Metrics, system status, alerts and recent activity
  - name: Batch
    description: Bulk credential issuance processes
  - name: Delegation & Propagation
    description: Delegation trees and cross-tenant delivery

security:
  - bearerAuth: []
    idToken: []

paths:
  # ===========================================================================
  # 1. Authentication & Session
  # ===========================================================================
  /auth/login:
    post:
      tags: [Authentication]
      summary: Authenticate with email and password
      operationId: login
      description: |
        Authenticate against AWS Cognito (`USER_PASSWORD_AUTH`). On success returns
        the token set; an MFA / first-login challenge is returned as
        `{ success: false, challengeName, challengeParameters, session }`.
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email, password]
              properties:
                email:
                  type: string
                  format: email
                password:
                  type: string
                  format: password
            example:
              email: user@example.com
              password: "••••••••"
      responses:
        '200':
          description: Authenticated
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean, example: true }
                  data:
                    $ref: '#/components/schemas/TokenSet'
              example:
                success: true
                data:
                  accessToken: "eyJ..."
                  idToken: "eyJ..."
                  refreshToken: "eyJ..."
        '400': { $ref: '#/components/responses/BadRequest' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /auth/logout:
    post:
      tags: [Authentication]
      summary: Invalidate the current session
      operationId: logout
      responses:
        '200':
          description: Session invalidated
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /auth/refresh:
    post:
      tags: [Authentication]
      summary: Exchange a refresh token for new tokens
      operationId: refreshToken
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [refreshToken]
              properties:
                refreshToken: { type: string }
            example:
              refreshToken: "eyJ..."
      responses:
        '200':
          description: New tokens issued
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/TokenSet' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /auth/me:
    get:
      tags: [Authentication]
      summary: Return the authenticated user
      operationId: getCurrentUser
      responses:
        '200':
          description: Authenticated user
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { type: object }
        '401': { $ref: '#/components/responses/Unauthorized' }

  # ===========================================================================
  # 2. Credentials
  # ===========================================================================
  /api/bl/credentials:
    get:
      tags: [Credentials]
      summary: List credentials
      operationId: listCredentials
      description: Returns issued and received credentials for the tenant.
      parameters:
        - { $ref: '#/components/parameters/SearchParam' }
        - { $ref: '#/components/parameters/PageParam' }
        - { $ref: '#/components/parameters/LimitParam' }
        - name: status
          in: query
          schema: { $ref: '#/components/schemas/CredentialStatus' }
        - name: levelOfAssurance
          in: query
          schema: { type: integer, minimum: 0, maximum: 3 }
        - { $ref: '#/components/parameters/SortParam' }
        - { $ref: '#/components/parameters/OrderParam' }
        - name: type
          in: query
          description: Credential type
          schema: { type: string }
        - name: issuer
          in: query
          description: Issuer DID (comma-separated supported for multi-DID tenants)
          schema: { type: string }
        - name: subject
          in: query
          description: Subject DID
          schema: { type: string }
        - name: catalogLabel
          in: query
          description: Filter by catalog document label
          schema: { type: string }
        - name: issuerTenantLike
          in: query
          description: Partial match on issuer tenant
          schema: { type: string }
        - name: validUntil
          in: query
          description: Unix epoch (seconds) — upper validity bound
          schema: { type: integer }
        - name: validFrom
          in: query
          description: Unix epoch (seconds) — lower validity bound
          schema: { type: integer }
        - name: keyClaim
          in: query
          description: Filter by a key claim value
          schema: { type: string }
      responses:
        '200':
          description: Paginated credential list
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: array
                    items: { $ref: '#/components/schemas/Credential' }
                  pagination: { $ref: '#/components/schemas/Pagination' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    post:
      tags: [Credentials]
      summary: Issue a new credential
      operationId: issueCredential
      description: The backend signs the credential and returns the signed token.
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/CredentialIssueRequest' }
            example:
              documentId: catalog-document-uuid
              issuerKey: kms-key-id-or-verification-method
              subject: did:web:...:tenants:acme
              claims:
                - { key: name, value: John Doe }
                - { key: role, value: Director }
              levelOfAssurance: 2
              expirationDate: "2027-06-18T00:00:00Z"
              format: w3c-vc
      responses:
        '201':
          description: Credential issued
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/Credential' }
        '400': { $ref: '#/components/responses/BadRequest' }
        '401': { $ref: '#/components/responses/Unauthorized' }
        '422': { $ref: '#/components/responses/ValidationFailed' }

  /api/bl/credentials/{jti}:
    parameters:
      - { $ref: '#/components/parameters/JtiPathParam' }
    get:
      tags: [Credentials]
      summary: Fetch a single credential by jti
      operationId: getCredential
      responses:
        '200':
          description: Credential
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/Credential' }
        '401': { $ref: '#/components/responses/Unauthorized' }
        '404': { $ref: '#/components/responses/NotFound' }
    post:
      tags: [Credentials]
      summary: Update credential metadata
      operationId: updateCredential
      description: |
        Single mutation entry point for non-cryptographic fields. The signed JWT is
        never modified.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              additionalProperties: true
            example:
              evidence_url: https://drive.google.com/file/d/1ABC...
      responses:
        '200':
          description: Updated
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/Credential' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/bl/credentials/{jti}/revoke:
    parameters:
      - { $ref: '#/components/parameters/JtiPathParam' }
    post:
      tags: [Credentials]
      summary: Revoke a credential
      operationId: revokeCredential
      requestBody:
        required: false
        content:
          application/json:
            schema:
              type: object
              properties:
                reason:
                  type: string
                  default: other
                comment:
                  type: string
            example:
              reason: other
              comment: Superseded by a new credential
      responses:
        '200':
          description: Revoked
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: object
                    properties:
                      id: { type: string }
                      status: { $ref: '#/components/schemas/CredentialStatus' }
              example:
                success: true
                data: { id: credential-jti-uuid, status: revoked }
        '401': { $ref: '#/components/responses/Unauthorized' }

  # 4. Presentation Requests & Presentations
  # ===========================================================================
  /api/bl/presentation-requests:
    get:
      tags: [Presentations]
      summary: List presentation requests
      operationId: listPresentationRequests
      parameters:
        - name: issuer
          in: query
          description: Requester DID
          schema: { type: string }
        - name: subject
          in: query
          description: Target holder DID
          schema: { type: string }
        - name: status
          in: query
          schema: { $ref: '#/components/schemas/PresentationRequestStatus' }
        - name: catalogEntryId
          in: query
          schema: { type: string }
        - { $ref: '#/components/parameters/LimitParam' }
        - { $ref: '#/components/parameters/PageParam' }
        - { $ref: '#/components/parameters/OrderParam' }
        - { $ref: '#/components/parameters/SortParam' }
        - name: created_from
          in: query
          schema: { type: string }
        - name: created_to
          in: query
          schema: { type: string }
      responses:
        '200':
          description: Presentation requests
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: array
                    items: { $ref: '#/components/schemas/PresentationRequest' }
                  pagination: { $ref: '#/components/schemas/Pagination' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    post:
      tags: [Presentations]
      summary: Issue a presentation request
      operationId: createPresentationRequest
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                formId: { type: string }
                subject: { type: string }
                requestedClaims:
                  type: array
                  items: { $ref: '#/components/schemas/RequestedClaim' }
                reason: { type: string }
                expiresAt: { type: string, format: date-time }
            example:
              formId: catalog-form-uuid
              subject: did:web:...:tenants:beta
              requestedClaims:
                - { key: name, loa: 2, required: true }
                - { key: dateOfBirth, loa: 2, required: false }
              reason: KYC verification
              expiresAt: "2026-06-25T00:00:00Z"
      responses:
        '201':
          description: Presentation request issued
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/PresentationRequest' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/bl/presentation-requests/{jti}:
    parameters:
      - { $ref: '#/components/parameters/JtiPathParam' }
    get:
      tags: [Presentations]
      summary: Fetch a single presentation request by jti
      operationId: getPresentationRequest
      responses:
        '200':
          description: Presentation request
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/PresentationRequest' }
        '401': { $ref: '#/components/responses/Unauthorized' }
        '404': { $ref: '#/components/responses/NotFound' }

  /api/bl/presentation-requests/{requestId}:
    parameters:
      - name: requestId
        in: path
        required: true
        schema: { type: string }
    post:
      tags: [Presentations]
      summary: Update a presentation request (e.g. mark fulfilled)
      operationId: updatePresentationRequest
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                status: { $ref: '#/components/schemas/PresentationRequestStatus' }
                presentationId: { type: string }
            example:
              status: fulfilled
              presentationId: presentation-jti-uuid
      responses:
        '200':
          description: Updated
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/bl/presentations/preview:
    post:
      tags: [Presentations]
      summary: Preview which credentials can satisfy a presentation request
      operationId: previewPresentation
      description: Does not sign anything; returns matchable credentials.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [presentationRequestJwt]
              properties:
                presentationRequestJwt: { type: string }
            example:
              presentationRequestJwt: "eyJ..."
      responses:
        '200':
          description: Matchable credentials
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: object
                    properties:
                      available:
                        type: array
                        items:
                          type: object
                          properties:
                            credentialId: { type: string }
                            matchedClaims:
                              type: array
                              items: { type: string }
              example:
                success: true
                data:
                  available:
                    - { credentialId: "...", matchedClaims: [name] }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/bl/presentations:
    get:
      tags: [Presentations]
      summary: List presentations
      operationId: listPresentations
      parameters:
        - { $ref: '#/components/parameters/PageParam' }
        - { $ref: '#/components/parameters/LimitParam' }
        - name: status
          in: query
          schema: { $ref: '#/components/schemas/PresentationStatus' }
        - name: issuer
          in: query
          schema: { type: string }
        - name: subject
          in: query
          schema: { type: string }
      responses:
        '200':
          description: Presentations
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: array
                    items: { $ref: '#/components/schemas/Presentation' }
                  pagination: { $ref: '#/components/schemas/Pagination' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    post:
      tags: [Presentations]
      summary: Issue a presentation in response to a presentation request
      operationId: createPresentation
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [presentationRequestJwt, credentials]
              properties:
                presentationRequestJwt: { type: string }
                credentials:
                  type: array
                  items: { type: string }
            example:
              presentationRequestJwt: "eyJ..."
              credentials: [credential-jti-1, credential-jti-2]
      responses:
        '201':
          description: Presentation issued
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/Presentation' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  # ===========================================================================
  # 5. Catalog
  # ===========================================================================
  /api/catalog/documents:
    get:
      tags: [Catalog]
      summary: List catalog documents
      operationId: listCatalogDocuments
      parameters:
        - name: state
          in: query
          schema: { $ref: '#/components/schemas/CatalogState' }
        - name: compliance_path
          in: query
          schema: { type: string }
        - { $ref: '#/components/parameters/SearchParam' }
        - { $ref: '#/components/parameters/PageParam' }
        - { $ref: '#/components/parameters/LimitParam' }
        - name: audience
          in: query
          schema: { type: string }
        - name: supported_format
          in: query
          schema: { $ref: '#/components/schemas/CredentialFormat' }
        - name: updated_from
          in: query
          schema: { type: string }
        - name: updated_to
          in: query
          schema: { type: string }
      responses:
        '200':
          description: Catalog documents
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: array
                    items: { $ref: '#/components/schemas/CatalogDocument' }
                  pagination: { $ref: '#/components/schemas/Pagination' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    post:
      tags: [Catalog]
      summary: Create a document
      operationId: createCatalogDocument
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/CatalogDocument' }
            example:
              name: Employee ID
              description: Corporate employee identity credential
              claims:
                - { key: name, dataType: string }
              supported_format: w3c-vc
      responses:
        '201':
          description: Document created
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/CatalogDocument' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/catalog/documents/{id}:
    parameters:
      - { $ref: '#/components/parameters/IdPathParam' }
    get:
      tags: [Catalog]
      summary: Fetch a document by UUID
      operationId: getCatalogDocument
      responses:
        '200':
          description: Document
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/CatalogDocument' }
        '401': { $ref: '#/components/responses/Unauthorized' }
        '404': { $ref: '#/components/responses/NotFound' }
    post:
      tags: [Catalog]
      summary: Update a document
      operationId: updateCatalogDocument
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/CatalogDocument' }
      responses:
        '200':
          description: Updated
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/CatalogDocument' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    delete:
      tags: [Catalog]
      summary: Delete a document
      operationId: deleteCatalogDocument
      responses:
        '200':
          description: Deleted
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/catalog/vct/{code}:
    parameters:
      - name: code
        in: path
        required: true
        description: dc+sd-jwt document code
        schema: { type: string }
    get:
      tags: [Catalog]
      summary: Fetch VCT metadata for a dc+sd-jwt document code
      operationId: getVct
      responses:
        '200':
          description: VCT metadata
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: object
                    properties:
                      display:
                        type: array
                        items:
                          type: object
                          properties:
                            lang: { type: string }
                            name: { type: string }
                            description: { type: string }
                      claims:
                        type: array
                        items:
                          type: object
                          properties:
                            path:
                              type: array
                              items: { type: string }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/catalog/forms:
    get:
      tags: [Catalog]
      summary: List forms
      operationId: listForms
      parameters:
        - name: state
          in: query
          schema: { $ref: '#/components/schemas/CatalogState' }
        - name: document_id
          in: query
          schema: { type: string }
        - { $ref: '#/components/parameters/SearchParam' }
        - { $ref: '#/components/parameters/PageParam' }
        - { $ref: '#/components/parameters/LimitParam' }
        - name: audience
          in: query
          schema: { type: string }
        - name: supported_format
          in: query
          schema: { $ref: '#/components/schemas/CredentialFormat' }
        - name: updated_from
          in: query
          schema: { type: string }
        - name: updated_to
          in: query
          schema: { type: string }
      responses:
        '200':
          description: Forms
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data:
                    type: array
                    items: { $ref: '#/components/schemas/Form' }
                  pagination: { $ref: '#/components/schemas/Pagination' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    post:
      tags: [Catalog]
      summary: Create a form
      operationId: createForm
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/Form' }
            example:
              document_id: doc-uuid
              title: Onboarding form
              state: draft
      responses:
        '201':
          description: Form created
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/Form' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/catalog/forms/{formId}:
    parameters:
      - { $ref: '#/components/parameters/FormIdPathParam' }
    get:
      tags: [Catalog]
      summary: Fetch a form by id
      operationId: getForm
      responses:
        '200':
          description: Form
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  data: { $ref: '#/components/schemas/Form' }
        '401': { $ref: '#/components/responses/Unauthorized' }
        '404': { $ref: '#/components/responses/NotFound' }
    post:
      tags: [Catalog]
      summary: Update a form
      operationId: updateForm
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/Form' }
      responses:
        '200':
          description: Updated
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    delete:
      tags: [Catalog]
      summary: Delete a form
      operationId: deleteForm
      responses:
        '200':
          description: Deleted
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/catalog/forms/{formId}/sections:
    parameters:
      - { $ref: '#/components/parameters/FormIdPathParam' }
    post:
      tags: [Catalog]
      summary: Create a section
      operationId: createFormSection
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                title: { type: string }
                order: { type: integer }
            example:
              title: Personal data
              order: 1
      responses:
        '201':
          description: Section created
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/catalog/forms/{formId}/sections/{sectionId}:
    parameters:
      - { $ref: '#/components/parameters/FormIdPathParam' }
      - name: sectionId
        in: path
        required: true
        schema: { type: string }
    post:
      tags: [Catalog]
