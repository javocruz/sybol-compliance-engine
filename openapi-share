  # ===========================================================================
  # 12. Delegation & Propagation
  # ===========================================================================
  /api/bl/delegate:
    get:
      tags: [Delegation & Propagation]
      summary: Retrieve delegation trees
      operationId: getDelegations
      description: The product returns the first match.
      parameters:
        - name: jti
          in: query
          schema: { type: string }
        - name: limit
          in: query
          schema: { type: integer, default: 50 }
        - name: offset
          in: query
          schema: { type: integer, default: 0 }
      responses:
        '200':
          description: Delegation trees
          content:
            application/json:
              schema: { $ref: '#/components/schemas/EnvelopeList' }
        '401': { $ref: '#/components/responses/Unauthorized' }
    post:
      tags: [Delegation & Propagation]
      summary: Create or update a delegation tree
      operationId: upsertDelegation
      description: Idempotent — re-posting the same jti overwrites it.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [jti, delegation_tree]
              properties:
                jti: { type: string }
                delegation_tree:
                  type: object
                  additionalProperties: { type: string }
            example:
              jti: delegation-uuid
              delegation_tree:
                "did:web:...:a": jti-a
                "did:web:...:b": jti-b
      responses:
        '200':
          description: Delegation upserted
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SuccessAck' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/ps/send:
    post:
      tags: [Delegation & Propagation]
      summary: Propagate a signed JWT to its recipient
      operationId: propagate
      description: |
        Delivers a signed JWT via the propagate service. When `data.propagated`
        is false the JWT was signed and persisted but **not delivered** (the
        recipient's DID document has no `SybolPropagateService` entry) — surface
        this as info, not failure.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [jwt]
              properties:
                jwt: { type: string }
                delegations:
                  type: array
                  items: { type: string }
            example:
              jwt: "eyJ..."
              delegations: [presentation-jti-1]
      responses:
        '200':
          description: Propagation result
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  message: { type: string }
                  data:
                    type: object
                    properties:
                      propagated: { type: boolean }
                      status: { type: string }
                      attempts: { type: integer }
                      targetUrl: { type: string }
                      jti: { type: string }
                      objectType: { type: string }
              example:
                success: true
                message: Propagation result
                data:
                  propagated: true
                  status: delivered
                  attempts: 1
                  targetUrl: "https://..."
                  jti: "..."
                  objectType: presentation
        '401': { $ref: '#/components/responses/Unauthorized' }

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: 'Cognito access token sent as `Authorization: Bearer <access_token>`.'
    idToken:
      type: apiKey
      in: header
      name: X-Id-Token
      description: >
        Cognito ID token; carries the `custom:tenant_id` claim used for
        tenant-isolated database access. Required by all /api/bl/*, /api/bo/*,
        /api/catalog/* and /api/ps/* endpoints.

  parameters:
    PageParam:
      name: page
      in: query
      description: Page number
      schema: { type: integer, minimum: 1 }
    LimitParam:
      name: limit
      in: query
      description: Results per page (25 | 50 | 100)
      schema: { type: integer, enum: [25, 50, 100] }
    SearchParam:
      name: search
      in: query
      description: Free-text search
      schema: { type: string }
    SortParam:
      name: sort
      in: query
      description: Sort field
      schema: { type: string }
    OrderParam:
      name: order
      in: query
      schema:
        type: string
        enum: [asc, desc]
    JtiPathParam:
      name: jti
      in: path
      required: true
      description: Credential / object jti (JWT id, URL-encoded)
      schema: { type: string }
    IdPathParam:
      name: id
      in: path
      required: true
      schema: { type: string }
    FormIdPathParam:
      name: formId
      in: path
      required: true
      schema: { type: string }
  responses:
    BadRequest:
      description: Bad request / invalid format (400)
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorResponse' }
    Unauthorized:
      description: Authentication required (401)
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorResponse' }
    Forbidden:
      description: Insufficient permissions (403)
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorResponse' }
    NotFound:
      description: Resource not found (404)
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorResponse' }
    ValidationFailed:
      description: Validation failed (422)
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorResponse' }

  schemas:
    # ----- Envelope & shared -----
    Pagination:
      type: object
      properties:
        page: { type: integer, example: 1 }
        limit: { type: integer, example: 25 }
        total: { type: integer, example: 137 }
    OffsetPagination:
      type: object
      properties:
        total: { type: integer, example: 12 }
        limit: { type: integer, example: 50 }
        offset: { type: integer, example: 0 }
    SuccessAck:
      type: object
      properties:
        success: { type: boolean, example: true }
        data: {}
    EnvelopeList:
      type: object
      properties:
        success: { type: boolean }
        data:
          type: array
          items: {}
        pagination: { $ref: '#/components/schemas/Pagination' }
    ErrorResponse:
      type: object
      properties:
        success: { type: boolean, example: false }
        error: { type: string, example: ERROR_CODE }
        message: { type: string, example: Human-readable description }
        details:
          type: object
          additionalProperties: true
        timestamp: { type: string, format: date-time }
        requestId: { type: string }
        path: { type: string }
    TokenSet:
      type: object
      properties:
        accessToken: { type: string }
        idToken: { type: string }
        refreshToken: { type: string }
        expiresIn: { type: integer }
        tokenType: { type: string, example: Bearer }
        issuedAt: { type: integer }
    ClaimValue:
      type: object
      properties:
        key: { type: string }
        value: { type: string }
    RequestedClaim:
      type: object
      properties:
        key: { type: string }
        loa: { type: integer }
        required: { type: boolean }
    CredentialStatus:
      type: string
      enum: [issued, revoked, suspended, expired, not-yet-valid, unknown]
    PresentationRequestStatus:
      type: string
      enum: [pending, fulfilled, expired, revoked, unknown]
    PresentationStatus:
      type: string
      enum: [sent, received, revoked, expired, unknown]
    CatalogState:
      type: string
      enum: [draft, active, archived]
    ContactStatus:
      type: string
      enum: [pending, accepted, connected, request, rejected, blocked]
    BatchStatus:
      type: string
      enum: [pending, processing, completed, failed, partial]
    ClaimDataType:
      type: string
      enum: [string, number, date, url, boolean, custom]
    CredentialFormat:
      type: string
      enum: [w3c-vc, dc+sd-jwt]

    # ----- Resources -----
    CredentialIssueRequest:
      type: object
      required: [documentId, issuerKey, subject, claims]
      properties:
        documentId: { type: string }
        issuerKey: { type: string }
        subject: { type: string }
        claims:
          type: array
          items: { $ref: '#/components/schemas/ClaimValue' }
        levelOfAssurance: { type: integer, minimum: 0, maximum: 3 }
        expirationDate: { type: string, format: date-time }
        format: { $ref: '#/components/schemas/CredentialFormat' }
    Credential:
      type: object
      properties:
        id: { type: string }
        signed_token: { type: string }
        status: { $ref: '#/components/schemas/CredentialStatus' }
        issuer: { type: string }
        subject: { type: string }
        created_at: { type: string, format: date-time }
    PresentationRequest:
      type: object
      properties:
        id: { type: string }
        signedToken: { type: string }
        status: { $ref: '#/components/schemas/PresentationRequestStatus' }
    Presentation:
      type: object
      properties:
        id: { type: string }
        signedToken: { type: string }
        status: { $ref: '#/components/schemas/PresentationStatus' }
    CatalogDocument:
      type: object
      properties:
        id: { type: string }
        name: { type: string }
        description: { type: string }
        claims:
          type: array
          items: { $ref: '#/components/schemas/Claim' }
        supported_format: { $ref: '#/components/schemas/CredentialFormat' }
        state: { $ref: '#/components/schemas/CatalogState' }
    Claim:
      type: object
      properties:
        id: { type: string }
        document_id: { type: string }
        key: { type: string }
        dataType: { $ref: '#/components/schemas/ClaimDataType' }
        required: { type: boolean }
        state: { $ref: '#/components/schemas/CatalogState' }
    Form:
      type: object
      properties:
        id: { type: string }
        document_id: { type: string }
        title: { type: string }
        state: { $ref: '#/components/schemas/CatalogState' }
    Contact:
      type: object
      properties:
        id: { type: integer }
        tenantId: { type: string }
        did: { type: string }
        businessName: { type: string }
        cif: { type: string }
        email: { type: string, format: email }
        tel: { type: string }
        status: { $ref: '#/components/schemas/ContactStatus' }
    Oid4vcOffer:
      type: object
      properties:
        success: { type: boolean }
        offerId: { type: string }
        offerUri: { type: string }
        status: { type: string }
        expiresAt: { type: string, format: date-time }
    VerificationSession:
      type: object
      properties:
        success: { type: boolean }
        sessionId: { type: string }
        status: { type: string }
        claims:
          type: object
          additionalProperties: true
        issuers:
          type: object
          additionalProperties: true
        holderDid: { type: string }
    BatchProcess:
      type: object
      properties:
        processId: { type: string }
        status: { $ref: '#/components/schemas/BatchStatus' }
        uploadUrl: { type: string }
        progress: { type: object, additionalProperties: true }
    ActivityMetrics:
      type: object
      properties:
        vc: { type: integer }
        prp: { type: integer }
        contacts: { type: integer }
        signatures: { type: integer }
