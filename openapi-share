                credentialType: { type: string }
                credentialData: { type: object, additionalProperties: true }
                recipientEmail: { type: string, format: email }
                expirationDate: { type: string, format: date-time }
                format: { $ref: '#/components/schemas/CredentialFormat' }
            example:
              credentialType: EmployeeID
              credentialData: { name: John Doe, role: Director }
              recipientEmail: john@example.com
              expirationDate: "2027-06-18T00:00:00Z"
              format: dc+sd-jwt
      responses:
        '201':
          description: Offer created
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Oid4vcOffer' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /api/bl/oid4vc/offers/{offerId}/status:
    parameters:
      - name: offerId
        in: path
        required: true
        schema: { type: string }
    get:
      tags: [OID4VC]
      summary: Poll the status of an issuance offer
      operationId: getOid4vcOfferStatus
      description: 'Offer lifecycle: pending → sent → token_issued → issued (or expired).'
      responses:
        '200':
          description: Offer status
          content:
            application/json:
              schema:
                type: object
                properties:
                  success: { type: boolean }
                  offerId: { type: string }
                  status:
                    type: string
                    enum: [pending, sent, token_issued, issued, expired]
        '401': { $ref: '#/components/responses/Unauthorized' }

