APP_ENV=dev

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

QDRANT_COLLECTION=regulations
QDRANT_AUDIT_COLLECTION=media_audit

MISTRAL_API_KEY=

# Sybol BusinessWallet API (see sybol_docs/openapi-wallet.yaml)
SYBOL_API_BASE_URL=https://api.develop.wallet.sybol.id

# Option A: tokens from POST /auth/login (or scripts/sybol_login.py)
SYBOL_ACCESS_TOKEN=
SYBOL_ID_TOKEN=

# Option B: login credentials — client calls /auth/login when tokens are empty
SYBOL_EMAIL=
SYBOL_PASSWORD=

# Catalog issuance (required for POST /api/bl/credentials)
SYBOL_DOCUMENT_ID=
SYBOL_ISSUER_KEY=
SYBOL_SUBJECT_DID=
SYBOL_LEVEL_OF_ASSURANCE=2

SYBOL_REQUEST_TIMEOUT=30.0
